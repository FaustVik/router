{
  "name": "faustvik/router",
  "description": "Lightweight PHP Router with built-in HTTP abstraction, Middleware support, Request/Response handling, Parameter Validation, and Route Caching for modern web applications",
  "keywords": [
    "php",
    "router",
    "routing",
    "http",
    "middleware",
    "request",
    "response",
    "validation",
    "cache",
    "rest-api",
    "url-parameters",
    "dependency-injection"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Victor",
      "email": "victor.faust.dev@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.1",
    "php-di/php-di": "^7.0",
    "psr/container": "^2.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.0",
    "rector/rector": "^2.5"
  },
  "autoload": {
    "psr-4": {
      "FaustVik\\Router\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FaustVik\\Router\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix",
    "phpstan": "phpstan analyse",
    "rector": "rector process"
  },
  "config": {
    "sort-packages": true
  }
}
